                      -c:v hevc_vaapi -profile:v 2 -vf hwupload,deinterlace_vaapi,scale_vaapi=h=1080:w=1920:format=p010 -b:v 3M -minrate:v 3M -maxrate:v 3M -bufsize:v 10485760 -y -f mpegts pipe:1'
